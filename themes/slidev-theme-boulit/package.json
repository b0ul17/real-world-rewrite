{
  "name": "slidev-theme-boulit",
  "version": "0.1.0",
  "description": "A warm-paper editorial theme for technical conference talks in Slidev",
  "author": "Andreas Panopoulos",
  "license": "MIT",
  "keywords": [
    "slidev-theme",
    "slidev",
    "presentation",
    "conference"
  ],
  "files": [
    "components",
    "layouts",
    "setup",
    "styles",
    "slide-top.vue",
    "example.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "slidev": ">=0.48.0"
  },
  "dependencies": {
    "@slidev/types": "^52.0.0"
  },
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "transition": "slide-left",
      "colorSchema": "light",
      "fonts": {
        "sans": "Avenir Next,Inter",
        "mono": "SFMono-Regular,Menlo",
        "local": "Avenir Next"
      }
    }
  }
}
